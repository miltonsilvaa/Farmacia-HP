POSTGRES_USER=admin
POSTGRES_PASSWORD=coloque_sua_senha_aqui
POSTGRES_DB=homeoformula_db
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=coloque_sua_senha_aqui
FRONTEND_PORT=5173
BACKEND_PORT=3000
# Integração com o ERP legado (opcional)
# ERP_MODO: mock (simulado em memória) | arquivo (grava em backend/erp-saida) | http (usa ERP_URL)
# Vazio = http se ERP_URL estiver preenchida, senão arquivo
ERP_MODO=
ERP_URL=
ERP_TOKEN=
ERP_FORMATO=json

# WhatsApp da farmácia para o botão de suporte (DDI+DDD+número, só dígitos, ex.: 5513999999999). Vazio esconde o botão.
WHATSAPP_FARMACIA=
# Dias após o pedido para enviar o lembrete de recompra
LEMBRETE_RECOMPRA_DIAS=25
