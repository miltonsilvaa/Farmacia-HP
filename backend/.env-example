# backend/.env

# A conexão do banco para o Prisma rodar na SUA máquina (repare no localhost)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Variáveis do MinIO que a sua API NestJS vai precisar ler para autenticar
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ROOT_USER="admin"
MINIO_ROOT_PASSWORD="senha_super_secreta_storage"

# E-mail (Mailpit em dev: caixa em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="Grupo Farmácia HP <nao-responda@farmaciahp.com.br>"
# MinIO: host que o navegador usa para abrir as receitas (links assinados)
MINIO_PUBLIC_ENDPOINT="localhost"

# ERP legado: com ERP_URL envia por HTTP; sem ela grava em ./erp-saida (json ou xml)
ERP_URL=""
ERP_TOKEN=""
ERP_FORMATO="json"
